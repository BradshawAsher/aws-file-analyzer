        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "15667783965316364335"
            }
          },
          "parameters": {
            "environmentName": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "string",
              "defaultValue": "[resourceGroup().location]"
            },
            "tags": {
              "type": "object",
              "defaultValue": {}
            },
            "principalId": {
              "type": "string"
            },
            "principalName": {
              "type": "string"
            },
            "tenantId": {
              "type": "string"
            },
            "cloudflareAllowedOrigin": {
              "type": "string"
            },
            "cloudflareWorkerAllowedOrigin": {
              "type": "string",
              "defaultValue": "https://aws-file-analyzer.bradshin231.workers.dev"
            },
            "deployerIpAddress": {
              "type": "string",
              "defaultValue": ""
            }
          },
          "variables": {
            "resourceToken": "[toLower(uniqueString(subscription().id, parameters('environmentName'), parameters('location')))]",
            "appServicePlanName": "[format('plan-afa-{0}', variables('resourceToken'))]",
            "apiName": "[format('app-afa-{0}', variables('resourceToken'))]",
            "sqlServerName": "[format('sql-afa-{0}', variables('resourceToken'))]",
            "sqlDatabaseName": "FileAnalyzer",
