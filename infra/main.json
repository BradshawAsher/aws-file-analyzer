                "siteConfig": {
                  "alwaysOn": false,
                  "ftpsState": "Disabled",
                  "healthCheckPath": "/health",
                  "http20Enabled": true,
                  "linuxFxVersion": "DOTNETCORE|8.0",
                  "appCommandLine": "dotnet OpenAiChat.dll",
                  "minTlsVersion": "1.2",
                  "scmMinTlsVersion": "1.2",
                  "appSettings": [
                    {
                      "name": "ASPNETCORE_ENVIRONMENT",
                      "value": "Production"
                    },
                    {
                      "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
