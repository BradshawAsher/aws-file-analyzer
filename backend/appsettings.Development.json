{
  "Gemini": {
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "Models": [
      "gemini-3.1-flash-lite",
      "gemini-3.5-flash-lite",
      "gemini-2.5-flash-lite",
      "gemini-2.5-flash",
      "gemini-3.5-flash",
      "gemini-3.6-flash",
      "gemini-3.7-flash",
      "gemini-3.8-flash"
    ],
    "MaxRetriesPerModel": 1,
    "InitialRetryDelayMilliseconds": 500
  },
  "AWS": {
    "Region": "us-east-1",
    "Profile": "default",
    "S3BucketName": "[TO_BE_UPDATE]"
  },
  "ConnectionStrings": {
    "DefaultConnection": "[TO_BE_UPDATE]"
  },
  "Jwt": {
    "Key": "a-very-long-secret-at-least-32-chars-or-better-rotate-in-prod",
    "Issuer": "MyApi",
    "Audience": "MyApiClients",
    "ExpiresInMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
